rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function hasVerifiedEmail() { return isAuthenticated() && request.auth.token.get('email_verified', false) == true; }
    function userPath(appId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(request.auth.uid); }
    function currentUser(appId) { return get(userPath(appId)).data; }
    function isActive(appId) { return hasVerifiedEmail() && exists(userPath(appId)) && currentUser(appId).ativo == true; }
    function isAdmin(appId) { return isActive(appId) && currentUser(appId).role == 'admin'; }
    function isGestor(appId) { return isActive(appId) && currentUser(appId).role == 'gestor'; }
    function isAtendimento(appId) { return isActive(appId) && currentUser(appId).role == 'atendimento'; }
    function isInternal(appId) { return isActive(appId) && currentUser(appId).role in ['admin', 'gestor', 'atendimento']; }
    function canRelocate(appId) { return isActive(appId) && currentUser(appId).role in ['admin', 'gestor']; }
    function auditPath(appId, id) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/auditoria/$(id); }
    function arbitraryUserPath(appId, uid) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(uid); }
    function personPath(appId, pessoaId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/pessoas/$(pessoaId); }
    function userPersonIndexPath(appId, pessoaId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/usuario_pessoa_index/$(pessoaId); }
    function isActiveMemberData(data) { return data.ativo != false && (data.vinculo == 'membro' || data.tipoPessoa == 'Membro'); }
    function isConsulenteData(data) { return data.vinculo == 'consulente' || data.tipoPessoa == 'Consulente'; }
    function validUserPersonLink(appId, uid, pessoaId) {
      return pessoaId is string
        && isActiveMemberData(get(personPath(appId, pessoaId)).data)
        && get(personPath(appId, pessoaId)).data.email is string
        && get(personPath(appId, pessoaId)).data.email.size() > 0
        && get(personPath(appId, pessoaId)).data.email == getAfter(arbitraryUserPath(appId, uid)).data.email
        && getAfter(userPersonIndexPath(appId, pessoaId)).data.uid == uid
        && getAfter(userPersonIndexPath(appId, pessoaId)).data.pessoaBaseId == pessoaId;
    }
    function appointmentPath(appId, id) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(id); }
    function activeLockPath(appId, agendaId, pessoaId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/agendamentos_ativos/$(agendaId + '_' + pessoaId); }
    function relocationEntryValid(data, ids, index, relocationId, destinationAgendaId, destinationAppointmentId, reason) {
      return ids.size() <= index || (
        data[ids[index]].realocacaoId == relocationId
        && data[ids[index]].destinoAgendaId == destinationAgendaId
        && data[ids[index]].destinoAgendamentoId == destinationAppointmentId
        && data[ids[index]].realocadoPor == request.auth.uid
        && data[ids[index]].motivo == reason
      );
    }
    function relocationEntriesValid(data, audit) {
      return relocationEntryValid(data, audit.servicosIds, 0, audit.realocacaoId, audit.destinoAgendaId, audit.destinoAgendamentoId, audit.motivo)
        && relocationEntryValid(data, audit.servicosIds, 1, audit.realocacaoId, audit.destinoAgendaId, audit.destinoAgendamentoId, audit.motivo)
        && relocationEntryValid(data, audit.servicosIds, 2, audit.realocacaoId, audit.destinoAgendaId, audit.destinoAgendamentoId, audit.motivo);
    }
    function validRelocationUpdate(appId, id) {
      let relocationId = request.resource.data.ultimaRealocacaoId;
      let audit = getAfter(auditPath(appId, relocationId)).data;
      let destination = getAfter(appointmentPath(appId, audit.destinoAgendamentoId)).data;
      let lock = getAfter(activeLockPath(appId, audit.destinoAgendaId, resource.data.pessoaBaseId)).data;
      let changedServices = request.resource.data.servicosRealocados.diff(resource.data.get('servicosRealocados', {})).affectedKeys();
      return canRelocate(appId)
        && !exists(auditPath(appId, relocationId))
        && audit.realocacaoId == relocationId
        && audit.origemAgendaId == resource.data.agendaId
        && audit.origemAgendamentoId == id
        && audit.destinoAgendaId != resource.data.agendaId
        && audit.executadoPor == request.auth.uid
        && audit.motivo is string && audit.motivo.size() > 0
        && audit.servicosIds is list && audit.servicosIds.size() > 0 && audit.servicosIds.size() <= 3
        && changedServices.hasOnly(audit.servicosIds) && changedServices.hasAll(audit.servicosIds)
        && relocationEntriesValid(request.resource.data.servicosRealocados, audit)
        && !exists(appointmentPath(appId, audit.destinoAgendamentoId))
        && destination.status == 'Agendado'
        && destination.agendaId == audit.destinoAgendaId
        && destination.pessoaBaseId == resource.data.pessoaBaseId
        && destination.servicosIds.hasOnly(audit.servicosIds) && destination.servicosIds.hasAll(audit.servicosIds)
        && destination.origemRealocacao.realocacaoId == relocationId
        && destination.origemRealocacao.agendaId == resource.data.agendaId
        && destination.origemRealocacao.agendamentoId == id
        && destination.origemRealocacao.realocadoPor == request.auth.uid
        && destination.origemRealocacao.motivo == audit.motivo
        && lock.agendamentoId == audit.destinoAgendamentoId
        && lock.agendaId == audit.destinoAgendaId
        && lock.pessoaBaseId == resource.data.pessoaBaseId
        && request.resource.data.atualizadoPor == request.auth.uid
        && resource.data.status == 'Agendado'
        && ((request.resource.data.status == 'Agendado'
            && audit.tipo == 'SERVICO_REALOCADO'
            && destination.origemRealocacao.tipo == 'parcial'
            && !request.resource.data.servicosRealocados.keys().hasAll(resource.data.servicosIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'servicosRealocados', 'ultimaRealocacaoId', 'atualizadoEm', 'atualizadoPor'
            ]))
          || (request.resource.data.status == 'Reagendado'
            && audit.tipo == 'ATENDIMENTO_REAGENDADO'
            && destination.origemRealocacao.tipo == 'completa'
            && request.resource.data.servicosRealocados.keys().hasAll(resource.data.servicosIds)
            && request.resource.data.reagendadoPor == request.auth.uid
            && request.resource.data.reagendadoParaAgendaId == audit.destinoAgendaId
            && request.resource.data.reagendadoParaAgendamentoId == audit.destinoAgendamentoId
            && request.resource.data.motivoRealocacao == audit.motivo));
    }

    match /artifacts/{appId}/public/data/usuarios/{uid} {
      allow get: if isAuthenticated() && (request.auth.uid == uid || isAdmin(appId));
      allow list: if isAdmin(appId);
      allow create: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'pendente'
        && request.resource.data.ativo == true
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'role', 'ativo', 'criadoEm', 'atualizadoEm']);
      allow update: if isAdmin(appId) && request.resource.data.uid == resource.data.uid
        && request.resource.data.atualizadoPor == request.auth.uid
        && ((resource.data.role == 'pendente' && request.auth.uid != uid
            && request.resource.data.role in ['admin', 'gestor', 'atendimento']
            && request.resource.data.ativo == true
            && validUserPersonLink(appId, uid, request.resource.data.pessoaBaseId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'ativo', 'pessoaBaseId', 'atualizadoEm', 'atualizadoPor']))
          || (resource.data.role in ['admin', 'gestor', 'atendimento']
            && !resource.data.keys().hasAny(['pessoaBaseId'])
            && request.resource.data.role == resource.data.role
            && request.resource.data.ativo == resource.data.ativo
            && validUserPersonLink(appId, uid, request.resource.data.pessoaBaseId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pessoaBaseId', 'atualizadoEm', 'atualizadoPor']))
          || (request.auth.uid != uid && request.resource.data.role == resource.data.role
            && request.resource.data.get('pessoaBaseId', '') == resource.data.get('pessoaBaseId', '')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo', 'atualizadoEm', 'atualizadoPor']))
          || (request.auth.uid != uid && resource.data.keys().hasAny(['pessoaBaseId'])
            && request.resource.data.pessoaBaseId == resource.data.pessoaBaseId
            && request.resource.data.role in ['admin', 'gestor', 'atendimento']
            && request.resource.data.ativo == resource.data.ativo
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'atualizadoEm', 'atualizadoPor'])));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/usuario_pessoa_index/{pessoaId} {
      allow read: if isAdmin(appId);
      allow create: if isAdmin(appId) && !exists(userPersonIndexPath(appId, pessoaId))
        && request.resource.data.pessoaBaseId == pessoaId
        && request.resource.data.uid is string
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.keys().hasOnly(['pessoaBaseId', 'uid', 'criadoEm', 'criadoPor'])
        && isActiveMemberData(get(personPath(appId, pessoaId)).data)
        && getAfter(arbitraryUserPath(appId, request.resource.data.uid)).data.pessoaBaseId == pessoaId
        && getAfter(auditPath(appId, 'usuario_acesso_' + request.resource.data.uid + '_' + pessoaId)).data.tipo in ['USUARIO_AUTORIZADO', 'USUARIO_VINCULADO']
        && getAfter(auditPath(appId, 'usuario_acesso_' + request.resource.data.uid + '_' + pessoaId)).data.alvoUid == request.resource.data.uid
        && getAfter(auditPath(appId, 'usuario_acesso_' + request.resource.data.uid + '_' + pessoaId)).data.pessoaBaseId == pessoaId;
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/auditoria/{id} {
      allow read: if isAdmin(appId);
      allow create: if isInternal(appId)
        && request.resource.data.executadoPor == request.auth.uid
        && ((isAdmin(appId) && request.resource.data.tipo in ['USUARIO_AUTORIZADO', 'USUARIO_VINCULADO', 'USUARIO_ROLE_ALTERADO', 'USUARIO_STATUS_ALTERADO'])
          || request.resource.data.tipo in ['AGENDAMENTO_CANCELADO', 'PRIORIDADE_ALTERADA', 'AGENDA_CONCLUIDA', 'AGENDA_EDITADA', 'AGENDA_CANCELADA', 'AGENDA_EXCLUIDA', 'SERVICO_AGENDA_CANCELADO']
          || (canRelocate(appId)
            && request.resource.data.tipo in ['ATENDIMENTO_REAGENDADO', 'SERVICO_REALOCADO']
            && id == request.resource.data.realocacaoId
            && getAfter(appointmentPath(appId, request.resource.data.origemAgendamentoId)).data.ultimaRealocacaoId == id
            && getAfter(appointmentPath(appId, request.resource.data.destinoAgendamentoId)).data.origemRealocacao.realocacaoId == id
            && getAfter(activeLockPath(appId, request.resource.data.destinoAgendaId, getAfter(appointmentPath(appId, request.resource.data.origemAgendamentoId)).data.pessoaBaseId)).data.agendamentoId == request.resource.data.destinoAgendamentoId)
          || (isAdmin(appId) && request.resource.data.tipo == 'STATUS_ATENDIMENTO_CORRIGIDO'));
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/pessoas/{id} {
      allow read: if isInternal(appId);
      allow create: if isAdmin(appId) || isGestor(appId)
        || (isAtendimento(appId) && isConsulenteData(request.resource.data)
          && request.resource.data.ativo == true
          && request.resource.data.get('funcoesCasa', []).size() == 0);
      allow update: if isAdmin(appId)
        || (isGestor(appId)
          && request.resource.data.atualizadoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vinculo', 'funcoesCasa', 'tipoPessoa', 'nome', 'dataNascimento', 'cpf', 'contato', 'email',
          'responsavelCpf', 'responsavelNome', 'responsavelContato', 'ativo', 'sexo', 'estadoCivil',
          'endereco', 'dadosCasa', 'statusCadastro', 'origemCadastro', 'busca', 'atualizadoEm', 'atualizadoPor'
        ]))
        || (isAtendimento(appId) && isConsulenteData(resource.data) && isConsulenteData(request.resource.data)
          && request.resource.data.get('vinculo', 'consulente') == resource.data.get('vinculo', 'consulente')
          && request.resource.data.get('tipoPessoa', 'Consulente') == resource.data.get('tipoPessoa', 'Consulente')
          && request.resource.data.get('funcoesCasa', []) == resource.data.get('funcoesCasa', [])
          && request.resource.data.ativo == resource.data.ativo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome', 'dataNascimento', 'cpf', 'contato', 'email', 'responsavelCpf', 'responsavelNome',
            'responsavelContato', 'busca', 'atualizadoEm', 'atualizadoPor'
          ]));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/cpf_index/{cpf} {
      allow read: if isInternal(appId);
      allow create: if isAdmin(appId) || isGestor(appId)
        || (isAtendimento(appId) && isConsulenteData(getAfter(personPath(appId, request.resource.data.pessoaId)).data));
      allow delete: if isAdmin(appId) || isGestor(appId)
        || (isAtendimento(appId) && isConsulenteData(getAfter(personPath(appId, resource.data.pessoaId)).data));
      allow update: if isAdmin(appId) || isGestor(appId);
    }

    match /artifacts/{appId}/public/data/agendas/{id} {
      allow read: if isInternal(appId);
      allow create: if isAdmin(appId) || isGestor(appId);
      allow update: if !(resource.data.get('status', 'Aberta') in ['Concluída', 'Cancelada'])
        && (isAdmin(appId) || isGestor(appId)
          || (isAtendimento(appId) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['vagasOcupadas', 'atualizadoEm', 'atualizadoPor'])));
      allow delete: if isAdmin(appId);
    }

    match /artifacts/{appId}/public/data/consulentes/{id} {
      allow read: if isInternal(appId);
      allow create: if isInternal(appId)
        && !(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(request.resource.data.agendaId)).data.get('status', 'Aberta') in ['Concluída', 'Cancelada'])
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendamentos_ativos/$(request.resource.data.agendaId + '_' + request.resource.data.pessoaBaseId)).data.agendamentoId == id;
      allow update: if request.resource.data.agendaId == resource.data.agendaId
        && ((isInternal(appId)
          && !(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(resource.data.agendaId)).data.get('status', 'Aberta') in ['Concluída', 'Cancelada'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'prioridade', 'horaChegada', 'horaSaida', 'canceladoEm', 'canceladoPor', 'motivoCancelamento', 'atualizadoEm', 'atualizadoPor'])
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'Agendado' && request.resource.data.status in ['Presente', 'Faltou', 'Cancelado'])
            || (resource.data.status == 'Presente' && request.resource.data.status in ['Concluído', 'Cancelado'])))
        || (isAdmin(appId)
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(resource.data.agendaId)).data.get('status', 'Aberta') != 'Cancelada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'horaChegada', 'horaSaida', 'atualizadoEm', 'atualizadoPor'])
          && request.resource.data.atualizadoPor == request.auth.uid
          && ((resource.data.status == 'Concluído' && request.resource.data.status == 'Presente'
              && !request.resource.data.keys().hasAny(['horaSaida'])
              && request.resource.data.horaChegada == resource.data.horaChegada)
            || (resource.data.status == 'Concluído' && request.resource.data.status == 'Agendado'
              && !request.resource.data.keys().hasAny(['horaChegada', 'horaSaida']))
            || (resource.data.status == 'Presente' && request.resource.data.status == 'Agendado'
              && !request.resource.data.keys().hasAny(['horaChegada', 'horaSaida']))
            || (resource.data.status == 'Faltou' && request.resource.data.status == 'Agendado')))
        || (request.resource.data.agendaId == resource.data.agendaId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'servicosRealocados', 'ultimaRealocacaoId', 'reagendadoEm', 'reagendadoPor',
            'reagendadoParaAgendaId', 'reagendadoParaAgendamentoId', 'motivoRealocacao', 'atualizadoEm', 'atualizadoPor'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['servicosRealocados', 'ultimaRealocacaoId'])
          && validRelocationUpdate(appId, id)));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/agendamentos_ativos/{id} {
      allow get: if isInternal(appId);
      allow list: if false;
      allow create: if isInternal(appId)
        && id == request.resource.data.agendaId + '_' + request.resource.data.pessoaBaseId
        && request.resource.data.keys().hasOnly(['agendaId', 'pessoaBaseId', 'agendamentoId', 'criadoEm', 'criadoPor'])
        && request.resource.data.criadoPor == request.auth.uid
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(request.resource.data.agendamentoId)).data.agendaId == request.resource.data.agendaId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(request.resource.data.agendamentoId)).data.pessoaBaseId == request.resource.data.pessoaBaseId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(request.resource.data.agendamentoId)).data.status in ['Agendado', 'Presente'];
      allow update: if false;
      allow delete: if isInternal(appId)
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(resource.data.agendamentoId)).data.status in ['Cancelado', 'Reagendado'];
    }

    match /artifacts/{appId}/public/data/{collectionName}/{id} {
      allow read: if collectionName in ['config_tipos_pessoa', 'config_funcoes_membro', 'config_eventos', 'config_servicos'] && isInternal(appId);
      allow create, update: if collectionName in ['config_tipos_pessoa', 'config_funcoes_membro', 'config_eventos', 'config_servicos'] && isAdmin(appId);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
