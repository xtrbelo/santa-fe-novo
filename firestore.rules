rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function hasVerifiedEmail() { return isAuthenticated() && request.auth.token.get('email_verified', false) == true; }
    function userPath(appId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(request.auth.uid); }
    function currentUser(appId) { return get(userPath(appId)).data; }
    function isActive(appId) { return hasVerifiedEmail() && exists(userPath(appId)) && currentUser(appId).ativo == true; }
    function isAdmin(appId) { return isActive(appId) && currentUser(appId).role == 'admin'; }
    function isGestor(appId) { return isActive(appId) && currentUser(appId).role == 'gestor'; }
    function isAtendimento(appId) { return isActive(appId) && currentUser(appId).role == 'atendimento'; }
    function isInternal(appId) { return isActive(appId) && currentUser(appId).role in ['admin', 'gestor', 'atendimento']; }
    function isOwnLinkedPerson(appId, pessoaId) {
      return isInternal(appId) && currentUser(appId).get('pessoaBaseId', '') == pessoaId;
    }
    function validMyRegistrationUpdate(appId, pessoaId) {
      return isOwnLinkedPerson(appId, pessoaId)
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contato', 'estadoCivil', 'endereco', 'busca', 'atualizadoEm', 'atualizadoPor'
        ])
        && (request.resource.data.contato == null
          || (request.resource.data.contato is string
            && request.resource.data.contato.matches('^[0-9]{1,11}$')))
        && request.resource.data.estadoCivil in ['solteiro', 'casado', 'uniao_estavel', 'separado', 'divorciado', 'viuvo', 'outro', 'nao_informado']
        && request.resource.data.endereco is map
        && request.resource.data.endereco.keys().hasOnly([
          'cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf'
        ])
        && (request.resource.data.endereco.cep == null
          || (request.resource.data.endereco.cep is string
            && request.resource.data.endereco.cep.matches('^[0-9]{8}$')))
        && (request.resource.data.endereco.uf == null
          || (request.resource.data.endereco.uf is string
            && request.resource.data.endereco.uf.matches('^[A-Z]{2}$')))
        && (request.resource.data.endereco.logradouro == null || request.resource.data.endereco.logradouro is string)
        && (request.resource.data.endereco.numero == null || request.resource.data.endereco.numero is string)
        && (request.resource.data.endereco.complemento == null || request.resource.data.endereco.complemento is string)
        && (request.resource.data.endereco.bairro == null || request.resource.data.endereco.bairro is string)
        && (request.resource.data.endereco.cidade == null || request.resource.data.endereco.cidade is string);
    }
    function validMyRegistrationAudit(appId) {
      return request.resource.data.tipo == 'MEU_CADASTRO_ATUALIZADO'
        && request.resource.data.keys().hasOnly([
          'tipo', 'pessoaBaseId', 'camposAlterados', 'executadoPor', 'criadoEm'
        ])
        && request.resource.data.pessoaBaseId == currentUser(appId).get('pessoaBaseId', '')
        && request.resource.data.camposAlterados is list
        && request.resource.data.camposAlterados.size() > 0
        && request.resource.data.camposAlterados.hasOnly([
          'contato', 'estadoCivil', 'endereco.cep', 'endereco.logradouro', 'endereco.numero',
          'endereco.complemento', 'endereco.bairro', 'endereco.cidade', 'endereco.uf'
        ])
        && request.resource.data.criadoEm is timestamp;
    }
    function canRelocate(appId) { return isActive(appId) && currentUser(appId).role in ['admin', 'gestor']; }
    function auditPath(appId, id) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/auditoria/$(id); }
    function arbitraryUserPath(appId, uid) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(uid); }
    function personPath(appId, pessoaId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/pessoas/$(pessoaId); }
    function memberInvitePath(appId, inviteId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/convites_membro/$(inviteId); }
    function memberSelfRegistrationPath(appId, inviteId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/autocadastros_membro/$(inviteId); }
    function memberInviteCpfIndexPath(appId, cpf) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/convite_membro_cpf_index/$(cpf); }
    function cpfIndexPath(appId, cpf) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/cpf_index/$(cpf); }
    function userPersonIndexPath(appId, pessoaId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/usuario_pessoa_index/$(pessoaId); }
    function accessAuthorizationPath(appId, pessoaId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/autorizacoes_acesso/$(pessoaId); }
    function isActiveMemberData(data) { return data.ativo != false && (data.vinculo == 'membro' || data.tipoPessoa == 'Membro'); }
    function isConsulenteData(data) { return data.vinculo == 'consulente' || data.tipoPessoa == 'Consulente'; }
    function hasValidAccessEmail(data) { return data.email is string && data.email.size() <= 254 && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'); }
    function isOwnPendingAuthorization(data) { return hasVerifiedEmail() && data.email == request.auth.token.email && data.status == 'pendente'; }
    function validAccessClaim(appId, uid, pessoaId) {
      let authorization = get(accessAuthorizationPath(appId, pessoaId)).data;
      let nextAuthorization = getAfter(accessAuthorizationPath(appId, pessoaId)).data;
      let person = get(personPath(appId, pessoaId)).data;
      let nextUser = getAfter(arbitraryUserPath(appId, uid)).data;
      let nextIndex = getAfter(userPersonIndexPath(appId, pessoaId)).data;
      let audit = getAfter(auditPath(appId, 'usuario_ativado_' + uid + '_' + pessoaId)).data;
      return request.auth.uid == uid && hasVerifiedEmail()
        && authorization.pessoaBaseId == pessoaId && authorization.status == 'pendente'
        && authorization.email == request.auth.token.email
        && authorization.role in ['admin', 'gestor', 'atendimento']
        && isActiveMemberData(person) && hasValidAccessEmail(person) && person.email == authorization.email
        && nextUser.uid == uid && nextUser.pessoaBaseId == pessoaId
        && nextUser.nome == person.nome && nextUser.email == authorization.email
        && nextUser.role == authorization.role && nextUser.ativo == true
        && nextUser.criadoPor == uid && nextUser.autorizadoPor == authorization.criadoPor
        && nextIndex.pessoaBaseId == pessoaId && nextIndex.uid == uid && nextIndex.criadoPor == uid
        && nextAuthorization.status == 'utilizado' && nextAuthorization.utilizadoPorUid == uid
        && nextAuthorization.email == authorization.email && nextAuthorization.role == authorization.role
        && nextAuthorization.pessoaBaseId == pessoaId && nextAuthorization.criadoPor == authorization.criadoPor
        && audit.tipo == 'USUARIO_ACESSO_ATIVADO' && audit.alvoUid == uid
        && audit.pessoaBaseId == pessoaId && audit.role == authorization.role
        && audit.autorizadoPor == authorization.criadoPor && audit.executadoPor == uid;
    }
    function canReviewMemberRegistration(appId) { return isAdmin(appId) || isGestor(appId); }
    function approvalAuditPath(appId, inviteId) { return auditPath(appId, 'autocadastro_aprovado_' + inviteId); }
    function rejectionAuditPath(appId, inviteId) { return auditPath(appId, 'autocadastro_rejeitado_' + inviteId); }
    function validApprovedSelfRegistration(appId, pessoaId, pessoaData) {
      let inviteId = get(memberInviteCpfIndexPath(appId, pessoaData.cpf)).data.inviteId;
      let registration = getAfter(memberSelfRegistrationPath(appId, inviteId)).data;
      let audit = getAfter(approvalAuditPath(appId, inviteId)).data;
      return pessoaData.origemCadastro == 'autocadastro'
        && registration.statusCadastro == 'aprovado'
        && registration.pessoaId == pessoaId
        && registration.cpf == pessoaData.cpf
        && registration.nome == pessoaData.nome
        && !existsAfter(memberInviteCpfIndexPath(appId, pessoaData.cpf))
        && getAfter(cpfIndexPath(appId, pessoaData.cpf)).data.pessoaId == pessoaId
        && audit.tipo == 'AUTOCADASTRO_MEMBRO_APROVADO'
        && audit.inviteId == inviteId && audit.pessoaId == pessoaId
        && audit.executadoPor == request.auth.uid;
    }
    function validUserPersonLink(appId, uid, pessoaId) {
      return pessoaId is string
        && isActiveMemberData(get(personPath(appId, pessoaId)).data)
        && get(personPath(appId, pessoaId)).data.email is string
        && get(personPath(appId, pessoaId)).data.email.size() > 0
        && get(personPath(appId, pessoaId)).data.email == getAfter(arbitraryUserPath(appId, uid)).data.email
        && getAfter(userPersonIndexPath(appId, pessoaId)).data.uid == uid
        && getAfter(userPersonIndexPath(appId, pessoaId)).data.pessoaBaseId == pessoaId;
    }
    function appointmentPath(appId, id) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(id); }
    function activeLockPath(appId, agendaId, pessoaId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/agendamentos_ativos/$(agendaId + '_' + pessoaId); }
    function relocationEntryValid(data, ids, index, relocationId, destinationAgendaId, destinationAppointmentId, reason) {
      return ids.size() <= index || (
        data[ids[index]].realocacaoId == relocationId
        && data[ids[index]].destinoAgendaId == destinationAgendaId
        && data[ids[index]].destinoAgendamentoId == destinationAppointmentId
        && data[ids[index]].realocadoPor == request.auth.uid
        && data[ids[index]].motivo == reason
      );
    }
    function relocationEntriesValid(data, audit) {
      return relocationEntryValid(data, audit.servicosIds, 0, audit.realocacaoId, audit.destinoAgendaId, audit.destinoAgendamentoId, audit.motivo)
        && relocationEntryValid(data, audit.servicosIds, 1, audit.realocacaoId, audit.destinoAgendaId, audit.destinoAgendamentoId, audit.motivo)
        && relocationEntryValid(data, audit.servicosIds, 2, audit.realocacaoId, audit.destinoAgendaId, audit.destinoAgendamentoId, audit.motivo);
    }
    function validRelocationUpdate(appId, id) {
      let relocationId = request.resource.data.ultimaRealocacaoId;
      let audit = getAfter(auditPath(appId, relocationId)).data;
      let destination = getAfter(appointmentPath(appId, audit.destinoAgendamentoId)).data;
      let lock = getAfter(activeLockPath(appId, audit.destinoAgendaId, resource.data.pessoaBaseId)).data;
      let changedServices = request.resource.data.servicosRealocados.diff(resource.data.get('servicosRealocados', {})).affectedKeys();
      return canRelocate(appId)
        && !exists(auditPath(appId, relocationId))
        && audit.realocacaoId == relocationId
        && audit.origemAgendaId == resource.data.agendaId
        && audit.origemAgendamentoId == id
        && audit.destinoAgendaId != resource.data.agendaId
        && audit.executadoPor == request.auth.uid
        && audit.motivo is string && audit.motivo.size() > 0
        && audit.servicosIds is list && audit.servicosIds.size() > 0 && audit.servicosIds.size() <= 3
        && changedServices.hasOnly(audit.servicosIds) && changedServices.hasAll(audit.servicosIds)
        && relocationEntriesValid(request.resource.data.servicosRealocados, audit)
        && !exists(appointmentPath(appId, audit.destinoAgendamentoId))
        && destination.status == 'Agendado'
        && destination.agendaId == audit.destinoAgendaId
        && destination.pessoaBaseId == resource.data.pessoaBaseId
        && destination.servicosIds.hasOnly(audit.servicosIds) && destination.servicosIds.hasAll(audit.servicosIds)
        && destination.origemRealocacao.realocacaoId == relocationId
        && destination.origemRealocacao.agendaId == resource.data.agendaId
        && destination.origemRealocacao.agendamentoId == id
        && destination.origemRealocacao.realocadoPor == request.auth.uid
        && destination.origemRealocacao.motivo == audit.motivo
        && lock.agendamentoId == audit.destinoAgendamentoId
        && lock.agendaId == audit.destinoAgendaId
        && lock.pessoaBaseId == resource.data.pessoaBaseId
        && request.resource.data.atualizadoPor == request.auth.uid
        && resource.data.status == 'Agendado'
        && ((request.resource.data.status == 'Agendado'
            && audit.tipo == 'SERVICO_REALOCADO'
            && destination.origemRealocacao.tipo == 'parcial'
            && !request.resource.data.servicosRealocados.keys().hasAll(resource.data.servicosIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'servicosRealocados', 'ultimaRealocacaoId', 'atualizadoEm', 'atualizadoPor'
            ]))
          || (request.resource.data.status == 'Reagendado'
            && audit.tipo == 'ATENDIMENTO_REAGENDADO'
            && destination.origemRealocacao.tipo == 'completa'
            && request.resource.data.servicosRealocados.keys().hasAll(resource.data.servicosIds)
            && request.resource.data.reagendadoPor == request.auth.uid
            && request.resource.data.reagendadoParaAgendaId == audit.destinoAgendaId
            && request.resource.data.reagendadoParaAgendamentoId == audit.destinoAgendamentoId
            && request.resource.data.motivoRealocacao == audit.motivo));
    }

    match /artifacts/{appId}/public/data/usuarios/{uid} {
      allow get: if isAuthenticated() && (request.auth.uid == uid || isAdmin(appId));
      allow list: if isAdmin(appId);
      allow create: if request.resource.data.keys().hasOnly(['uid', 'pessoaBaseId', 'nome', 'email', 'role', 'ativo', 'criadoEm', 'criadoPor', 'autorizadoPor', 'atualizadoEm', 'atualizadoPor'])
        && validAccessClaim(appId, uid, request.resource.data.pessoaBaseId);
      allow update: if isAdmin(appId) && request.resource.data.uid == resource.data.uid
        && request.resource.data.atualizadoPor == request.auth.uid
        && ((resource.data.role == 'pendente' && request.auth.uid != uid
            && request.resource.data.role in ['admin', 'gestor', 'atendimento']
            && request.resource.data.ativo == true
            && validUserPersonLink(appId, uid, request.resource.data.pessoaBaseId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'ativo', 'pessoaBaseId', 'atualizadoEm', 'atualizadoPor']))
          || (resource.data.role in ['admin', 'gestor', 'atendimento']
            && !resource.data.keys().hasAny(['pessoaBaseId'])
            && request.resource.data.role == resource.data.role
            && request.resource.data.ativo == resource.data.ativo
            && validUserPersonLink(appId, uid, request.resource.data.pessoaBaseId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pessoaBaseId', 'atualizadoEm', 'atualizadoPor']))
          || (request.auth.uid != uid && request.resource.data.role == resource.data.role
            && request.resource.data.get('pessoaBaseId', '') == resource.data.get('pessoaBaseId', '')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo', 'atualizadoEm', 'atualizadoPor']))
          || (request.auth.uid != uid && resource.data.keys().hasAny(['pessoaBaseId'])
            && request.resource.data.pessoaBaseId == resource.data.pessoaBaseId
            && request.resource.data.role in ['admin', 'gestor', 'atendimento']
            && request.resource.data.ativo == resource.data.ativo
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'atualizadoEm', 'atualizadoPor'])));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/usuario_pessoa_index/{pessoaId} {
      allow get: if isAdmin(appId)
        || (exists(accessAuthorizationPath(appId, pessoaId))
          && isOwnPendingAuthorization(get(accessAuthorizationPath(appId, pessoaId)).data));
      allow list: if isAdmin(appId);
      allow create: if !exists(userPersonIndexPath(appId, pessoaId)) && ((isAdmin(appId)
        && request.resource.data.pessoaBaseId == pessoaId
        && request.resource.data.uid is string
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.keys().hasOnly(['pessoaBaseId', 'uid', 'criadoEm', 'criadoPor'])
        && isActiveMemberData(get(personPath(appId, pessoaId)).data)
        && getAfter(arbitraryUserPath(appId, request.resource.data.uid)).data.pessoaBaseId == pessoaId
        && getAfter(auditPath(appId, 'usuario_acesso_' + request.resource.data.uid + '_' + pessoaId)).data.tipo in ['USUARIO_AUTORIZADO', 'USUARIO_VINCULADO']
        && getAfter(auditPath(appId, 'usuario_acesso_' + request.resource.data.uid + '_' + pessoaId)).data.alvoUid == request.resource.data.uid
        && getAfter(auditPath(appId, 'usuario_acesso_' + request.resource.data.uid + '_' + pessoaId)).data.pessoaBaseId == pessoaId)
        || (request.auth.uid == request.resource.data.uid
          && request.resource.data.keys().hasOnly(['pessoaBaseId', 'uid', 'criadoEm', 'criadoPor'])
          && validAccessClaim(appId, request.resource.data.uid, pessoaId)));
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/autorizacoes_acesso/{pessoaId} {
      allow get, list: if isAdmin(appId) || isOwnPendingAuthorization(resource.data);
      allow create: if isAdmin(appId)
        && request.resource.data.keys().hasOnly(['pessoaBaseId', 'email', 'role', 'status', 'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor', 'auditoriaPreautorizacaoId'])
        && request.resource.data.pessoaBaseId == pessoaId
        && request.resource.data.status == 'pendente'
        && request.resource.data.role in ['admin', 'gestor', 'atendimento']
        && request.resource.data.criadoPor == request.auth.uid && request.resource.data.atualizadoPor == request.auth.uid
        && isActiveMemberData(get(personPath(appId, pessoaId)).data)
        && hasValidAccessEmail(get(personPath(appId, pessoaId)).data)
        && get(personPath(appId, pessoaId)).data.email == request.resource.data.email
        && !exists(userPersonIndexPath(appId, pessoaId))
        && getAfter(auditPath(appId, request.resource.data.auditoriaPreautorizacaoId)).data.tipo == 'USUARIO_ACESSO_PREAUTORIZADO';
      allow update: if (isAdmin(appId)
          && resource.data.status in ['pendente', 'cancelado']
          && ((resource.data.status == 'pendente' && request.resource.data.status == 'cancelado'
              && request.resource.data.canceladoPor == request.auth.uid
              && request.resource.data.email == resource.data.email && request.resource.data.role == resource.data.role
              && request.resource.data.pessoaBaseId == resource.data.pessoaBaseId
              && request.resource.data.criadoPor == resource.data.criadoPor && request.resource.data.criadoEm == resource.data.criadoEm
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceladoEm', 'canceladoPor', 'atualizadoEm', 'atualizadoPor', 'auditoriaCancelamentoId'])
              && getAfter(auditPath(appId, request.resource.data.auditoriaCancelamentoId)).data.tipo == 'USUARIO_ACESSO_AUTORIZACAO_CANCELADA')
            || (resource.data.status == 'cancelado' && request.resource.data.status == 'pendente'
              && request.resource.data.criadoPor == request.auth.uid
              && request.resource.data.pessoaBaseId == pessoaId
              && request.resource.data.role in ['admin', 'gestor', 'atendimento']
              && isActiveMemberData(get(personPath(appId, pessoaId)).data)
              && hasValidAccessEmail(get(personPath(appId, pessoaId)).data)
              && request.resource.data.email == get(personPath(appId, pessoaId)).data.email
              && !exists(userPersonIndexPath(appId, pessoaId))
              && getAfter(auditPath(appId, request.resource.data.auditoriaPreautorizacaoId)).data.tipo == 'USUARIO_ACESSO_PREAUTORIZADO')))
        || (isOwnPendingAuthorization(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'utilizadoEm', 'utilizadoPorUid', 'atualizadoEm', 'atualizadoPor'])
          && validAccessClaim(appId, request.auth.uid, pessoaId));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/auditoria/{id} {
      allow read: if isAdmin(appId);
      allow create: if request.resource.data.executadoPor == request.auth.uid
        && ((isInternal(appId) && ((isAdmin(appId) && request.resource.data.tipo in ['USUARIO_AUTORIZADO', 'USUARIO_VINCULADO', 'USUARIO_ROLE_ALTERADO', 'USUARIO_STATUS_ALTERADO', 'USUARIO_ACESSO_PREAUTORIZADO', 'USUARIO_ACESSO_AUTORIZACAO_CANCELADA'])
          || request.resource.data.tipo in ['AGENDAMENTO_CANCELADO', 'PRIORIDADE_ALTERADA', 'AGENDA_CONCLUIDA', 'AGENDA_EDITADA', 'AGENDA_CANCELADA', 'AGENDA_EXCLUIDA', 'SERVICO_AGENDA_CANCELADO']
          || (canRelocate(appId)
            && request.resource.data.tipo in ['ATENDIMENTO_REAGENDADO', 'SERVICO_REALOCADO']
            && id == request.resource.data.realocacaoId
            && getAfter(appointmentPath(appId, request.resource.data.origemAgendamentoId)).data.ultimaRealocacaoId == id
            && getAfter(appointmentPath(appId, request.resource.data.destinoAgendamentoId)).data.origemRealocacao.realocacaoId == id
            && getAfter(activeLockPath(appId, request.resource.data.destinoAgendaId, getAfter(appointmentPath(appId, request.resource.data.origemAgendamentoId)).data.pessoaBaseId)).data.agendamentoId == request.resource.data.destinoAgendamentoId)
          || (isAdmin(appId) && request.resource.data.tipo == 'STATUS_ATENDIMENTO_CORRIGIDO')
          || validMyRegistrationAudit(appId)
          || (canReviewMemberRegistration(appId)
            && request.resource.data.tipo == 'AUTOCADASTRO_MEMBRO_APROVADO'
            && id == 'autocadastro_aprovado_' + request.resource.data.inviteId
            && getAfter(memberSelfRegistrationPath(appId, request.resource.data.inviteId)).data.statusCadastro == 'aprovado'
            && getAfter(memberSelfRegistrationPath(appId, request.resource.data.inviteId)).data.pessoaId == request.resource.data.pessoaId)
          || (canReviewMemberRegistration(appId)
            && request.resource.data.tipo == 'AUTOCADASTRO_MEMBRO_REJEITADO'
            && id == 'autocadastro_rejeitado_' + request.resource.data.inviteId
            && request.resource.data.motivo is string && request.resource.data.motivo.size() > 0
            && getAfter(memberSelfRegistrationPath(appId, request.resource.data.inviteId)).data.statusCadastro == 'rejeitado'
            && getAfter(memberSelfRegistrationPath(appId, request.resource.data.inviteId)).data.motivoRejeicao == request.resource.data.motivo)))
          || (request.resource.data.tipo == 'USUARIO_ACESSO_ATIVADO'
            && id == 'usuario_ativado_' + request.auth.uid + '_' + request.resource.data.pessoaBaseId
            && validAccessClaim(appId, request.auth.uid, request.resource.data.pessoaBaseId)));
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/pessoas/{id} {
      allow get: if isInternal(appId) || (exists(accessAuthorizationPath(appId, id)) && isOwnPendingAuthorization(get(accessAuthorizationPath(appId, id)).data));
      allow list: if isInternal(appId);
      allow create: if ((isAdmin(appId) || isGestor(appId))
          && request.resource.data.get('origemCadastro', 'administrativo') != 'autocadastro')
        || (canReviewMemberRegistration(appId)
          && request.resource.data.vinculo == 'membro'
          && request.resource.data.tipoPessoa == 'Membro'
          && request.resource.data.funcoesCasa.size() == 0
          && request.resource.data.ativo == true
          && request.resource.data.statusCadastro == 'aprovado'
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.atualizadoPor == request.auth.uid
          && validApprovedSelfRegistration(appId, id, request.resource.data))
        || (isAtendimento(appId) && isConsulenteData(request.resource.data)
          && request.resource.data.ativo == true
          && request.resource.data.get('funcoesCasa', []).size() == 0);
      allow update: if isAdmin(appId)
        || (isGestor(appId)
          && request.resource.data.atualizadoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vinculo', 'funcoesCasa', 'tipoPessoa', 'nome', 'dataNascimento', 'cpf', 'contato', 'email',
          'responsavelCpf', 'responsavelNome', 'responsavelContato', 'ativo', 'sexo', 'estadoCivil',
          'endereco', 'dadosCasa', 'statusCadastro', 'origemCadastro', 'busca', 'atualizadoEm', 'atualizadoPor'
        ]))
        || (isAtendimento(appId) && isConsulenteData(resource.data) && isConsulenteData(request.resource.data)
          && request.resource.data.get('vinculo', 'consulente') == resource.data.get('vinculo', 'consulente')
          && request.resource.data.get('tipoPessoa', 'Consulente') == resource.data.get('tipoPessoa', 'Consulente')
          && request.resource.data.get('funcoesCasa', []) == resource.data.get('funcoesCasa', [])
          && request.resource.data.ativo == resource.data.ativo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome', 'dataNascimento', 'cpf', 'contato', 'email', 'responsavelCpf', 'responsavelNome',
            'responsavelContato', 'busca', 'atualizadoEm', 'atualizadoPor'
          ]))
        || validMyRegistrationUpdate(appId, id);
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/cpf_index/{cpf} {
      allow read: if isInternal(appId);
      allow create: if ((isAdmin(appId) || isGestor(appId))
          && getAfter(personPath(appId, request.resource.data.pessoaId)).data.get('origemCadastro', 'administrativo') != 'autocadastro')
        || (canReviewMemberRegistration(appId)
          && request.resource.data.pessoaId is string
          && getAfter(personPath(appId, request.resource.data.pessoaId)).data.cpf == cpf
          && validApprovedSelfRegistration(appId, request.resource.data.pessoaId, getAfter(personPath(appId, request.resource.data.pessoaId)).data))
        || (isAtendimento(appId) && isConsulenteData(getAfter(personPath(appId, request.resource.data.pessoaId)).data));
      allow delete: if isAdmin(appId) || isGestor(appId)
        || (isAtendimento(appId) && isConsulenteData(getAfter(personPath(appId, resource.data.pessoaId)).data));
      allow update: if isAdmin(appId) || isGestor(appId);
    }

    match /artifacts/{appId}/public/data/convites_membro/{inviteId} {
      allow get: if isAdmin(appId) || isGestor(appId)
        || (request.auth == null
          && resource.data.status in ['ativo', 'respondido']
          && resource.data.expiraEm is timestamp
          && resource.data.expiraEm > request.time);
      allow list: if isAdmin(appId) || isGestor(appId);
      allow create: if (isAdmin(appId) || isGestor(appId))
        && inviteId.size() == 64
        && request.resource.data.keys().hasOnly([
          'nome', 'cpf', 'email', 'status', 'criadoEm', 'criadoPor', 'expiraEm', 'atualizadoEm', 'atualizadoPor'
        ])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0
        && request.resource.data.cpf is string && request.resource.data.cpf.size() == 11
        && (request.resource.data.email == null || request.resource.data.email is string)
        && request.resource.data.status == 'ativo'
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm > request.time
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/cpf_index/$(request.resource.data.cpf))
        && getAfter(memberInviteCpfIndexPath(appId, request.resource.data.cpf)).data.inviteId == inviteId;
      allow update: if ((isAdmin(appId) || isGestor(appId))
        && resource.data.status == 'ativo'
        && request.resource.data.status == 'revogado'
        && request.resource.data.revogadoEm is timestamp
        && request.resource.data.revogadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'revogadoEm', 'revogadoPor', 'atualizadoEm', 'atualizadoPor'
        ])
        && (!existsAfter(memberInviteCpfIndexPath(appId, resource.data.cpf))
          || getAfter(memberInviteCpfIndexPath(appId, resource.data.cpf)).data.inviteId != inviteId)
        && request.resource.data.keys().hasOnly([
          'nome', 'cpf', 'email', 'status', 'criadoEm', 'criadoPor', 'expiraEm', 'atualizadoEm', 'atualizadoPor',
          'revogadoEm', 'revogadoPor'
        ]))
        || (request.auth == null
          && inviteId.matches('^[a-f0-9]{64}$')
          && resource.data.status == 'ativo'
          && resource.data.expiraEm is timestamp
          && resource.data.expiraEm > request.time
          && request.resource.data.status == 'respondido'
          && request.resource.data.respondidoEm == request.time
          && request.resource.data.atualizadoEm == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondidoEm', 'atualizadoEm'])
          && request.resource.data.keys().hasOnly([
            'nome', 'cpf', 'email', 'status', 'criadoEm', 'criadoPor', 'expiraEm', 'atualizadoEm', 'atualizadoPor',
            'respondidoEm'
          ])
          && !exists(memberSelfRegistrationPath(appId, inviteId))
          && existsAfter(memberSelfRegistrationPath(appId, inviteId))
          && getAfter(memberSelfRegistrationPath(appId, inviteId)).data.inviteId == inviteId
          && getAfter(memberSelfRegistrationPath(appId, inviteId)).data.nome == resource.data.nome
          && getAfter(memberSelfRegistrationPath(appId, inviteId)).data.cpf == resource.data.cpf
          && getAfter(memberSelfRegistrationPath(appId, inviteId)).data.statusCadastro == 'aguardando_validacao'
          && getAfter(memberSelfRegistrationPath(appId, inviteId)).data.origemCadastro == 'autocadastro');
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/autocadastros_membro/{inviteId} {
      allow get, list: if isAdmin(appId) || isGestor(appId);
      allow create: if request.auth == null
        && inviteId.matches('^[a-f0-9]{64}$')
        && !exists(memberSelfRegistrationPath(appId, inviteId))
        && request.resource.data.keys().hasOnly([
          'inviteId', 'nome', 'cpf', 'dataNascimento', 'contato', 'email', 'sexo', 'estadoCivil', 'endereco',
          'statusCadastro', 'origemCadastro', 'enviadoEm', 'atualizadoEm'
        ])
        && request.resource.data.inviteId == inviteId
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 150
        && request.resource.data.cpf is string && request.resource.data.cpf.matches('^[0-9]{11}$')
        && (request.resource.data.dataNascimento == null || request.resource.data.dataNascimento is string && request.resource.data.dataNascimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (request.resource.data.contato == null || request.resource.data.contato is string && request.resource.data.contato.matches('^[0-9]{1,11}$'))
        && (request.resource.data.email == null || request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && request.resource.data.sexo in ['masculino', 'feminino', 'outro', 'nao_informado']
        && request.resource.data.estadoCivil in ['solteiro', 'casado', 'uniao_estavel', 'separado', 'divorciado', 'viuvo', 'outro', 'nao_informado']
        && request.resource.data.endereco is map
        && request.resource.data.endereco.keys().hasOnly(['cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf'])
        && (request.resource.data.endereco.cep == null || request.resource.data.endereco.cep is string && request.resource.data.endereco.cep.matches('^[0-9]{8}$'))
        && (request.resource.data.endereco.logradouro == null || request.resource.data.endereco.logradouro is string && request.resource.data.endereco.logradouro.size() <= 150)
        && (request.resource.data.endereco.numero == null || request.resource.data.endereco.numero is string && request.resource.data.endereco.numero.size() <= 30)
        && (request.resource.data.endereco.complemento == null || request.resource.data.endereco.complemento is string && request.resource.data.endereco.complemento.size() <= 100)
        && (request.resource.data.endereco.bairro == null || request.resource.data.endereco.bairro is string && request.resource.data.endereco.bairro.size() <= 100)
        && (request.resource.data.endereco.cidade == null || request.resource.data.endereco.cidade is string && request.resource.data.endereco.cidade.size() <= 100)
        && (request.resource.data.endereco.uf == null || request.resource.data.endereco.uf is string && request.resource.data.endereco.uf.matches('^[A-Z]{2}$'))
        && request.resource.data.statusCadastro == 'aguardando_validacao'
        && request.resource.data.origemCadastro == 'autocadastro'
        && request.resource.data.enviadoEm == request.time
        && request.resource.data.atualizadoEm == request.time
        && exists(memberInvitePath(appId, inviteId))
        && get(memberInvitePath(appId, inviteId)).data.status == 'ativo'
        && get(memberInvitePath(appId, inviteId)).data.expiraEm is timestamp
        && get(memberInvitePath(appId, inviteId)).data.expiraEm > request.time
        && request.resource.data.nome == get(memberInvitePath(appId, inviteId)).data.nome
        && request.resource.data.cpf == get(memberInvitePath(appId, inviteId)).data.cpf
        && getAfter(memberInvitePath(appId, inviteId)).data.status == 'respondido'
        && getAfter(memberInvitePath(appId, inviteId)).data.respondidoEm == request.time;
      allow update: if canReviewMemberRegistration(appId)
        && resource.data.statusCadastro == 'aguardando_validacao'
        && request.resource.data.inviteId == inviteId
        && request.resource.data.cpf == resource.data.cpf
        && request.resource.data.nome == resource.data.nome
        && request.resource.data.analisadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'statusCadastro', 'pessoaId', 'motivoRejeicao', 'analisadoEm', 'analisadoPor', 'atualizadoEm'
        ])
        && get(memberInvitePath(appId, inviteId)).data.status == 'respondido'
        && get(memberInvitePath(appId, inviteId)).data.cpf == resource.data.cpf
        && get(memberInvitePath(appId, inviteId)).data.nome == resource.data.nome
        && get(memberInviteCpfIndexPath(appId, resource.data.cpf)).data.inviteId == inviteId
        && !existsAfter(memberInviteCpfIndexPath(appId, resource.data.cpf))
        && ((request.resource.data.statusCadastro == 'aprovado'
            && request.resource.data.pessoaId is string
            && !exists(cpfIndexPath(appId, resource.data.cpf))
            && getAfter(cpfIndexPath(appId, resource.data.cpf)).data.pessoaId == request.resource.data.pessoaId
            && getAfter(personPath(appId, request.resource.data.pessoaId)).data.cpf == resource.data.cpf
            && getAfter(personPath(appId, request.resource.data.pessoaId)).data.origemCadastro == 'autocadastro'
            && getAfter(approvalAuditPath(appId, inviteId)).data.tipo == 'AUTOCADASTRO_MEMBRO_APROVADO')
          || (request.resource.data.statusCadastro == 'rejeitado'
            && request.resource.data.motivoRejeicao is string
            && request.resource.data.motivoRejeicao.size() > 0
            && !request.resource.data.keys().hasAny(['pessoaId'])
            && getAfter(rejectionAuditPath(appId, inviteId)).data.tipo == 'AUTOCADASTRO_MEMBRO_REJEITADO'
            && getAfter(rejectionAuditPath(appId, inviteId)).data.motivo == request.resource.data.motivoRejeicao));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/convite_membro_cpf_index/{cpf} {
      allow read: if isAdmin(appId) || isGestor(appId);
      allow create: if (isAdmin(appId) || isGestor(appId))
        && request.resource.data.keys().hasOnly(['inviteId', 'criadoEm', 'criadoPor'])
        && request.resource.data.inviteId is string && request.resource.data.inviteId.size() == 64
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.criadoPor == request.auth.uid
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.cpf == cpf
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.status == 'ativo'
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.criadoPor == request.auth.uid;
      allow update: if (isAdmin(appId) || isGestor(appId))
        && resource.data.keys().hasOnly(['inviteId', 'criadoEm', 'criadoPor'])
        && resource.data.inviteId is string && resource.data.inviteId.size() == 64
        && request.resource.data.keys().hasOnly(['inviteId', 'criadoEm', 'criadoPor'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteId', 'criadoEm', 'criadoPor'])
        && request.resource.data.inviteId is string && request.resource.data.inviteId.size() == 64
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.criadoPor == request.auth.uid
        && get(memberInvitePath(appId, resource.data.inviteId)).data.cpf == cpf
        && get(memberInvitePath(appId, resource.data.inviteId)).data.status == 'ativo'
        && (getAfter(memberInvitePath(appId, resource.data.inviteId)).data.status == 'revogado'
          || (get(memberInvitePath(appId, resource.data.inviteId)).data.expiraEm is timestamp
            && get(memberInvitePath(appId, resource.data.inviteId)).data.expiraEm <= request.time))
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.cpf == cpf
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.status == 'ativo'
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.expiraEm is timestamp
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.expiraEm > request.time
        && getAfter(memberInvitePath(appId, request.resource.data.inviteId)).data.criadoPor == request.auth.uid;
      allow delete: if (isAdmin(appId) || isGestor(appId))
        && resource.data.inviteId is string
        && ((get(memberInvitePath(appId, resource.data.inviteId)).data.status == 'ativo'
            && getAfter(memberInvitePath(appId, resource.data.inviteId)).data.status == 'revogado')
          || (get(memberInvitePath(appId, resource.data.inviteId)).data.status == 'respondido'
            && get(memberInvitePath(appId, resource.data.inviteId)).data.cpf == cpf
            && getAfter(memberSelfRegistrationPath(appId, resource.data.inviteId)).data.statusCadastro in ['aprovado', 'rejeitado']
            && (getAfter(approvalAuditPath(appId, resource.data.inviteId)).data.tipo == 'AUTOCADASTRO_MEMBRO_APROVADO'
              || getAfter(rejectionAuditPath(appId, resource.data.inviteId)).data.tipo == 'AUTOCADASTRO_MEMBRO_REJEITADO')));
    }

    match /artifacts/{appId}/public/data/agendas/{id} {
      allow read: if isInternal(appId);
      allow create: if isAdmin(appId) || isGestor(appId);
      allow update: if !(resource.data.get('status', 'Aberta') in ['Concluída', 'Cancelada'])
        && (isAdmin(appId) || isGestor(appId)
          || (isAtendimento(appId) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['vagasOcupadas', 'atualizadoEm', 'atualizadoPor'])));
      allow delete: if isAdmin(appId);
    }

    match /artifacts/{appId}/public/data/consulentes/{id} {
      allow read: if isInternal(appId);
      allow create: if isInternal(appId)
        && !(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(request.resource.data.agendaId)).data.get('status', 'Aberta') in ['Concluída', 'Cancelada'])
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendamentos_ativos/$(request.resource.data.agendaId + '_' + request.resource.data.pessoaBaseId)).data.agendamentoId == id;
      allow update: if request.resource.data.agendaId == resource.data.agendaId
        && ((isInternal(appId)
          && !(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(resource.data.agendaId)).data.get('status', 'Aberta') in ['Concluída', 'Cancelada'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'prioridade', 'horaChegada', 'horaSaida', 'canceladoEm', 'canceladoPor', 'motivoCancelamento', 'atualizadoEm', 'atualizadoPor'])
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'Agendado' && request.resource.data.status in ['Presente', 'Faltou', 'Cancelado'])
            || (resource.data.status == 'Presente' && request.resource.data.status in ['Concluído', 'Cancelado'])))
        || (isAdmin(appId)
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(resource.data.agendaId)).data.get('status', 'Aberta') != 'Cancelada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'horaChegada', 'horaSaida', 'atualizadoEm', 'atualizadoPor'])
          && request.resource.data.atualizadoPor == request.auth.uid
          && ((resource.data.status == 'Concluído' && request.resource.data.status == 'Presente'
              && !request.resource.data.keys().hasAny(['horaSaida'])
              && request.resource.data.horaChegada == resource.data.horaChegada)
            || (resource.data.status == 'Concluído' && request.resource.data.status == 'Agendado'
              && !request.resource.data.keys().hasAny(['horaChegada', 'horaSaida']))
            || (resource.data.status == 'Presente' && request.resource.data.status == 'Agendado'
              && !request.resource.data.keys().hasAny(['horaChegada', 'horaSaida']))
            || (resource.data.status == 'Faltou' && request.resource.data.status == 'Agendado')))
        || (request.resource.data.agendaId == resource.data.agendaId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'servicosRealocados', 'ultimaRealocacaoId', 'reagendadoEm', 'reagendadoPor',
            'reagendadoParaAgendaId', 'reagendadoParaAgendamentoId', 'motivoRealocacao', 'atualizadoEm', 'atualizadoPor'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['servicosRealocados', 'ultimaRealocacaoId'])
          && validRelocationUpdate(appId, id)));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/agendamentos_ativos/{id} {
      allow get: if isInternal(appId);
      allow list: if false;
      allow create: if isInternal(appId)
        && id == request.resource.data.agendaId + '_' + request.resource.data.pessoaBaseId
        && request.resource.data.keys().hasOnly(['agendaId', 'pessoaBaseId', 'agendamentoId', 'criadoEm', 'criadoPor'])
        && request.resource.data.criadoPor == request.auth.uid
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(request.resource.data.agendamentoId)).data.agendaId == request.resource.data.agendaId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(request.resource.data.agendamentoId)).data.pessoaBaseId == request.resource.data.pessoaBaseId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(request.resource.data.agendamentoId)).data.status in ['Agendado', 'Presente'];
      allow update: if false;
      allow delete: if isInternal(appId)
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/consulentes/$(resource.data.agendamentoId)).data.status in ['Cancelado', 'Reagendado'];
    }

    match /artifacts/{appId}/public/data/{collectionName}/{id} {
      allow read: if collectionName in ['config_tipos_pessoa', 'config_funcoes_membro', 'config_eventos', 'config_servicos'] && isInternal(appId);
      allow create, update: if collectionName in ['config_tipos_pessoa', 'config_funcoes_membro', 'config_eventos', 'config_servicos'] && isAdmin(appId);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
