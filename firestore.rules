rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function userPath(appId) { return /databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(request.auth.uid); }
    function currentUser(appId) { return get(userPath(appId)).data; }
    function isActive(appId) { return isAuthenticated() && exists(userPath(appId)) && currentUser(appId).ativo == true; }
    function isAdmin(appId) { return isActive(appId) && currentUser(appId).role == 'admin'; }
    function isGestor(appId) { return isActive(appId) && currentUser(appId).role == 'gestor'; }
    function isAtendimento(appId) { return isActive(appId) && currentUser(appId).role == 'atendimento'; }
    function isInternal(appId) { return isAdmin(appId) || isGestor(appId) || isAtendimento(appId); }

    match /artifacts/{appId}/public/data/usuarios/{uid} {
      allow get: if isAuthenticated() && (request.auth.uid == uid || isAdmin(appId));
      allow list: if isAdmin(appId);
      allow create: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'pendente'
        && request.resource.data.ativo == true
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'role', 'ativo', 'criadoEm', 'atualizadoEm']);
      allow update: if isAdmin(appId)
        && request.auth.uid != uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role in ['admin', 'gestor', 'atendimento', 'pendente']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'ativo', 'atualizadoEm', 'atualizadoPor']);
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/auditoria/{id} {
      allow read: if isAdmin(appId);
      allow create: if isInternal(appId)
        && request.resource.data.executadoPor == request.auth.uid
        && ((isAdmin(appId) && request.resource.data.tipo in ['USUARIO_ROLE_ALTERADO', 'USUARIO_STATUS_ALTERADO'])
          || request.resource.data.tipo in ['AGENDAMENTO_CANCELADO', 'PRIORIDADE_ALTERADA', 'AGENDA_CONCLUIDA']);
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/pessoas/{id} {
      allow read: if isInternal(appId);
      allow create, update: if isAdmin(appId) || isGestor(appId);
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/cpf_index/{cpf} {
      allow read, create, update, delete: if isAdmin(appId) || isGestor(appId);
    }

    match /artifacts/{appId}/public/data/agendas/{id} {
      allow read: if isInternal(appId);
      allow create: if isAdmin(appId) || isGestor(appId);
      allow update: if resource.data.get('status', 'Aberta') != 'Concluída'
        && (isAdmin(appId) || isGestor(appId)
          || (isAtendimento(appId) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['vagasOcupadas', 'atualizadoEm', 'atualizadoPor'])));
      allow delete: if isAdmin(appId);
    }

    match /artifacts/{appId}/public/data/consulentes/{id} {
      allow read: if isInternal(appId);
      allow create: if isInternal(appId)
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(request.resource.data.agendaId)).data.get('status', 'Aberta') != 'Concluída';
      allow update: if isInternal(appId)
        && request.resource.data.agendaId == resource.data.agendaId
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/agendas/$(resource.data.agendaId)).data.get('status', 'Aberta') != 'Concluída';
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/{collectionName}/{id} {
      allow read: if collectionName in ['config_tipos_pessoa', 'config_eventos', 'config_servicos'] && isInternal(appId);
      allow create, update: if collectionName in ['config_tipos_pessoa', 'config_eventos', 'config_servicos'] && isAdmin(appId);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
